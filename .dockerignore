# Prepared samples replace raw training corpora in the runtime image.
data/
archive/
# Include finished binary snapshots, but no temporary cache files.
training-cache/*
!training-cache/*.bin
# Training data: three tiers, each with and without doc comments (never high).
!training-cache/documented/
training-cache/documented/*
!training-cache/documented/tier_1_low.bin
!training-cache/documented/tier_2_mild.bin
!training-cache/documented/tier_3_moderate.bin
!training-cache/undocumented/
training-cache/undocumented/*
!training-cache/undocumented/tier_1_low.bin
!training-cache/undocumented/tier_2_mild.bin
!training-cache/undocumented/tier_3_moderate.bin
# Optional Rust books stage.
!training-cache/rust_docs/
training-cache/rust_docs/*
!training-cache/rust_docs/rust_docs.bin
!training-cache/rust_docs/report.json
