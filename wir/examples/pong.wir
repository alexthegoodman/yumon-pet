wir 0.2
# One Pong step on an integer grid (pong_w16_h12_p3_s1_m1, generated by `wir pong`).
# Field 16 x 12: paddles live in columns 0 and 15, the ball in columns 1..14
# and rows 0..11. A paddle at p covers rows p..p+2. Ball velocities are -1 or +1,
# controls -1, 0 or +1. Every value is an integer, so every comparison is exact.

input bx: R1 in [1, 14]
input by: R1 in [0, 11]
input vx, vy: R1 in [-1, 1]
input pl, pr: R1 in [0, 9]
input ul, ur: R1 in [-1, 1]

# paddles move 1 row(s) per step and stop at the walls
output pl2 = clip(pl + ul, 0, 9)
output pr2 = clip(pr + ur, 0, 9)

# the ball bounces off the top and bottom walls
let ny = by + vy
let wall_lo = lt(ny, 0)
let wall_hi = gt(ny, 11)
let y = ny + 2*relu(-ny) - 2*relu(ny - 11)

# reaching a paddle column: a hit reflects, a miss scores
let nx = bx + vx
let at_l = lt(nx, 1)
let at_r = gt(nx, 14)
let hit_l = and(at_l, ge(y, pl2), le(y, pl2 + 2))
let hit_r = and(at_r, ge(y, pr2), le(y, pr2 + 2))
let miss = at_l + at_r - hit_l - hit_r
let x = nx + 2*relu(1 - nx) - 2*relu(nx - 14)

# after a miss the ball restarts in the middle, heading back the way it came from
output bx2 = select(miss, 8, x)
output by2 = select(miss, 6, y)
output vx2 = vx + 2*at_l - 2*at_r
output vy2 = vy + 2*wall_lo - 2*wall_hi
output point_l = at_r - hit_r
output point_r = at_l - hit_l

# inputs in order: bx, by, vx, vy, pl, pr, ul, ur
assert bx2(8, 6, 1, 1, 0, 9, 0, 0) == 9, by2(8, 6, 1, 1, 0, 9, 0, 0) == 7, vx2(8, 6, 1, 1, 0, 9, 0, 0) == 1, vy2(8, 6, 1, 1, 0, 9, 0, 0) == 1, point_r(8, 6, 1, 1, 0, 9, 0, 0) == 0
assert bx2(8, 0, 1, -1, 9, 0, 1, -1) == 9, by2(8, 0, 1, -1, 9, 0, 1, -1) == 1, vx2(8, 0, 1, -1, 9, 0, 1, -1) == 1, vy2(8, 0, 1, -1, 9, 0, 1, -1) == 1, point_r(8, 0, 1, -1, 9, 0, 1, -1) == 0
assert bx2(1, 6, -1, 1, 6, 0, 0, 0) == 2, by2(1, 6, -1, 1, 6, 0, 0, 0) == 7, vx2(1, 6, -1, 1, 6, 0, 0, 0) == 1, vy2(1, 6, -1, 1, 6, 0, 0, 0) == 1, point_r(1, 6, -1, 1, 6, 0, 0, 0) == 0
assert bx2(1, 6, -1, 1, 0, 0, 0, 0) == 8, by2(1, 6, -1, 1, 0, 0, 0, 0) == 6, vx2(1, 6, -1, 1, 0, 0, 0, 0) == 1, vy2(1, 6, -1, 1, 0, 0, 0, 0) == 1, point_r(1, 6, -1, 1, 0, 0, 0, 0) == 1
