table passed_w(s) = [0, 0, 0, 0, 0, 0, 0, 0, 5, 5, 5, 5, 5, 5, 5, 5, 10, 10, 10, 10, 10, 10, 10, 10, 20, 20, 20, 20, 20, 20, 20, 20, 35, 35, 35, 35, 35, 35, 35, 35, 60, 60, 60, 60, 60, 60, 60, 60, 100, 100, 100, 100, 100, 100, 100, 100, 0, 0, 0, 0, 0, 0, 0, 0]
table passed_b(s) = [0, 0, 0, 0, 0, 0, 0, 0, 100, 100, 100, 100, 100, 100, 100, 100, 60, 60, 60, 60, 60, 60, 60, 60, 35, 35, 35, 35, 35, 35, 35, 35, 20, 20, 20, 20, 20, 20, 20, 20, 10, 10, 10, 10, 10, 10, 10, 10, 5, 5, 5, 5, 5, 5, 5, 5, 0, 0, 0, 0, 0, 0, 0, 0]

# --- attack maps: the first piece in each direction, and who attacks from where
let rw0 = best(w_orth(piece), and(onray(0, q(pos), k(pos)), occ(k(piece))), near(0, q(pos), k(pos)))
let rb0 = best(b_orth(piece), and(onray(0, q(pos), k(pos)), occ(k(piece))), near(0, q(pos), k(pos)))
let uw0 = best(w_orth_u(piece), and(onray(0, q(pos), k(pos)), occ(k(piece))), near(0, q(pos), k(pos)))
let ub0 = best(b_orth_u(piece), and(onray(0, q(pos), k(pos)), occ(k(piece))), near(0, q(pos), k(pos)))
let rw1 = best(w_orth(piece), and(onray(1, q(pos), k(pos)), occ(k(piece))), near(1, q(pos), k(pos)))
let rb1 = best(b_orth(piece), and(onray(1, q(pos), k(pos)), occ(k(piece))), near(1, q(pos), k(pos)))
let uw1 = best(w_orth_u(piece), and(onray(1, q(pos), k(pos)), occ(k(piece))), near(1, q(pos), k(pos)))
let ub1 = best(b_orth_u(piece), and(onray(1, q(pos), k(pos)), occ(k(piece))), near(1, q(pos), k(pos)))
let rw2 = best(w_orth(piece), and(onray(2, q(pos), k(pos)), occ(k(piece))), near(2, q(pos), k(pos)))
let rb2 = best(b_orth(piece), and(onray(2, q(pos), k(pos)), occ(k(piece))), near(2, q(pos), k(pos)))
let uw2 = best(w_orth_u(piece), and(onray(2, q(pos), k(pos)), occ(k(piece))), near(2, q(pos), k(pos)))
let ub2 = best(b_orth_u(piece), and(onray(2, q(pos), k(pos)), occ(k(piece))), near(2, q(pos), k(pos)))
let rw3 = best(w_orth(piece), and(onray(3, q(pos), k(pos)), occ(k(piece))), near(3, q(pos), k(pos)))
let rb3 = best(b_orth(piece), and(onray(3, q(pos), k(pos)), occ(k(piece))), near(3, q(pos), k(pos)))
let uw3 = best(w_orth_u(piece), and(onray(3, q(pos), k(pos)), occ(k(piece))), near(3, q(pos), k(pos)))
let ub3 = best(b_orth_u(piece), and(onray(3, q(pos), k(pos)), occ(k(piece))), near(3, q(pos), k(pos)))
let rw4 = best(w_diag(piece), and(onray(4, q(pos), k(pos)), occ(k(piece))), near(4, q(pos), k(pos)))
let rb4 = best(b_diag(piece), and(onray(4, q(pos), k(pos)), occ(k(piece))), near(4, q(pos), k(pos)))
let uw4 = best(w_diag_u(piece), and(onray(4, q(pos), k(pos)), occ(k(piece))), near(4, q(pos), k(pos)))
let ub4 = best(b_diag_u(piece), and(onray(4, q(pos), k(pos)), occ(k(piece))), near(4, q(pos), k(pos)))
let rw5 = best(w_diag(piece), and(onray(5, q(pos), k(pos)), occ(k(piece))), near(5, q(pos), k(pos)))
let rb5 = best(b_diag(piece), and(onray(5, q(pos), k(pos)), occ(k(piece))), near(5, q(pos), k(pos)))
let uw5 = best(w_diag_u(piece), and(onray(5, q(pos), k(pos)), occ(k(piece))), near(5, q(pos), k(pos)))
let ub5 = best(b_diag_u(piece), and(onray(5, q(pos), k(pos)), occ(k(piece))), near(5, q(pos), k(pos)))
let rw6 = best(w_diag(piece), and(onray(6, q(pos), k(pos)), occ(k(piece))), near(6, q(pos), k(pos)))
let rb6 = best(b_diag(piece), and(onray(6, q(pos), k(pos)), occ(k(piece))), near(6, q(pos), k(pos)))
let uw6 = best(w_diag_u(piece), and(onray(6, q(pos), k(pos)), occ(k(piece))), near(6, q(pos), k(pos)))
let ub6 = best(b_diag_u(piece), and(onray(6, q(pos), k(pos)), occ(k(piece))), near(6, q(pos), k(pos)))
let rw7 = best(w_diag(piece), and(onray(7, q(pos), k(pos)), occ(k(piece))), near(7, q(pos), k(pos)))
let rb7 = best(b_diag(piece), and(onray(7, q(pos), k(pos)), occ(k(piece))), near(7, q(pos), k(pos)))
let uw7 = best(w_diag_u(piece), and(onray(7, q(pos), k(pos)), occ(k(piece))), near(7, q(pos), k(pos)))
let ub7 = best(b_diag_u(piece), and(onray(7, q(pos), k(pos)), occ(k(piece))), near(7, q(pos), k(pos)))
let wn = count(and(knight(q(pos), k(pos)), is(k(piece), 2)))
let bn = count(and(knight(q(pos), k(pos)), is(k(piece), 8)))
let wp = count(and(wpawn_hits(q(pos), k(pos)), is(k(piece), 1)))
let bp = count(and(bpawn_hits(q(pos), k(pos)), is(k(piece), 7)))
let wk = count(and(kadj(q(pos), k(pos)), is(k(piece), 6)))
let bk = count(and(kadj(q(pos), k(pos)), is(k(piece), 12)))
output att_w = rw0 + rw1 + rw2 + rw3 + rw4 + rw5 + rw6 + rw7 + wn + wp + wk
output att_b = rb0 + rb1 + rb2 + rb3 + rb4 + rb5 + rb6 + rb7 + bn + bp + bk
output low_w = 30 - max(max(max(uw0, uw1), max(uw2, max(uw3, uw4))), max(max(uw5, max(uw6, uw7)), max(27 * clip(wn, 0, 1), max(29 * clip(wp, 0, 1), 10 * clip(wk, 0, 1)))))
output low_b = 30 - max(max(max(ub0, ub1), max(ub2, max(ub3, ub4))), max(max(ub5, max(ub6, ub7)), max(27 * clip(bn, 0, 1), max(29 * clip(bp, 0, 1), 10 * clip(bk, 0, 1)))))

# --- per-square terms (white = side to move)
let hit_w = gt(att_w, 0)
let hit_b = gt(att_b, 0)
# hanging: attacked, and undefended or attacked by something cheaper
output hanging_w = and(hit_b, or(not(hit_w), lt(low_b, unit_w(piece))), gt(unit_w(piece), 0))
output hanging_b = and(hit_w, or(not(hit_b), lt(low_w, unit_b(piece))), gt(unit_b(piece), 0))
let hang_us_c = select(hanging_w, hang_w(piece), 0)
let hang_them_c = select(hanging_b, hang_b(piece), 0)
let mob_c = select(1 - white(piece), att_w, 0) - select(1 - black(piece), att_b, 0)
# king zone: squares next to a king, attacked by the other side
let king_c = select(clip(bk, 0, 1), att_w, 0) - select(clip(wk, 0, 1), att_b, 0)
let blockers_w = count(and(wfront(q(pos), k(pos)), is(k(piece), 7)))
let blockers_b = count(and(bfront(q(pos), k(pos)), is(k(piece), 1)))
let passed_c = select(and(is(piece, 1), le(blockers_w, 0)), passed_w(pos), 0) - select(and(is(piece, 7), le(blockers_b, 0)), passed_b(pos), 0)
let file_pawns = count(and(samefile(q(pos), k(pos)), pawn(k(piece))))
let rooks_c = and(is(piece, 4), le(file_pawns, 0)) - and(is(piece, 10), le(file_pawns, 0))

# --- totals over the board (one shared head) and the phase blend
let mg = 64 * mean(pst_mg(piece, pos), true)
let eg = 64 * mean(pst_eg(piece, pos), true)
output mobility = 64 * mean(mob_c, true)
output king = 64 * mean(king_c, true)
output hang_us = 64 * mean(hang_us_c, true)
output hang_them = 64 * mean(hang_them_c, true)
output passed = 64 * mean(passed_c, true)
output rooks = 64 * mean(rooks_c, true)
let dmg = mg - eg
let phase_x_d = select(minor(piece), dmg, 0) + 2 * select(rook(piece), dmg, 0) + 4 * select(queen(piece), dmg, 0)
output pst = eg + 64 * mean(phase_x_d, true) / 24
output eval = 1 * pst + 4 * mobility + 8 * king + -0.15 * hang_us + 0.5 * hang_them + 1 * passed + 20 * rooks
