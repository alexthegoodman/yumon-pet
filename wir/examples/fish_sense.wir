wir 0.2
# Senses of one fish (generated by `wir swarm`). A grid program: the outputs at a cell are
# what an agent in that cell perceives, read from the 5 x 5 window around it.
# own0..own7 count fish per cell by heading (E NE N NW W SW S SE, capped at 3),
# other counts the other species (capped at 6), m is water (0 to 16).
# Open cells for a fish: no wall, 4 to 16 units of water.

input own0: grid in [0, 3] pad 0
input own1: grid in [0, 3] pad 0
input own2: grid in [0, 3] pad 0
input own3: grid in [0, 3] pad 0
input own4: grid in [0, 3] pad 0
input own5: grid in [0, 3] pad 0
input own6: grid in [0, 3] pad 0
input own7: grid in [0, 3] pad 0
input other: grid in [0, 6] pad 0
input m: grid in [0, 16] pad 0
input wall: grid in [0, 1] pad 1
input dist: grid in [0, 64] pad 64

let crowd = own0 + own1 + own2 + own3 + own4 + own5 + own6 + own7
let open = clip(m - 3 - 16*wall, 0, 1)

# a: neighbours heading each way (alignment). cap - relu(cap - x) is min(x, cap).
output a0 = 12 - relu(12 - (own0[-2, -2] + own0[-2, -1] + own0[-2, 0] + own0[-2, 1] + own0[-2, 2] + own0[-1, -2] + own0[-1, -1] + own0[-1, 0] + own0[-1, 1] + own0[-1, 2] + own0[0, -2] + own0[0, -1] + own0 + own0[0, 1] + own0[0, 2] + own0[1, -2] + own0[1, -1] + own0[1, 0] + own0[1, 1] + own0[1, 2] + own0[2, -2] + own0[2, -1] + own0[2, 0] + own0[2, 1] + own0[2, 2]))
output a1 = 12 - relu(12 - (own1[-2, -2] + own1[-2, -1] + own1[-2, 0] + own1[-2, 1] + own1[-2, 2] + own1[-1, -2] + own1[-1, -1] + own1[-1, 0] + own1[-1, 1] + own1[-1, 2] + own1[0, -2] + own1[0, -1] + own1 + own1[0, 1] + own1[0, 2] + own1[1, -2] + own1[1, -1] + own1[1, 0] + own1[1, 1] + own1[1, 2] + own1[2, -2] + own1[2, -1] + own1[2, 0] + own1[2, 1] + own1[2, 2]))
output a2 = 12 - relu(12 - (own2[-2, -2] + own2[-2, -1] + own2[-2, 0] + own2[-2, 1] + own2[-2, 2] + own2[-1, -2] + own2[-1, -1] + own2[-1, 0] + own2[-1, 1] + own2[-1, 2] + own2[0, -2] + own2[0, -1] + own2 + own2[0, 1] + own2[0, 2] + own2[1, -2] + own2[1, -1] + own2[1, 0] + own2[1, 1] + own2[1, 2] + own2[2, -2] + own2[2, -1] + own2[2, 0] + own2[2, 1] + own2[2, 2]))
output a3 = 12 - relu(12 - (own3[-2, -2] + own3[-2, -1] + own3[-2, 0] + own3[-2, 1] + own3[-2, 2] + own3[-1, -2] + own3[-1, -1] + own3[-1, 0] + own3[-1, 1] + own3[-1, 2] + own3[0, -2] + own3[0, -1] + own3 + own3[0, 1] + own3[0, 2] + own3[1, -2] + own3[1, -1] + own3[1, 0] + own3[1, 1] + own3[1, 2] + own3[2, -2] + own3[2, -1] + own3[2, 0] + own3[2, 1] + own3[2, 2]))
output a4 = 12 - relu(12 - (own4[-2, -2] + own4[-2, -1] + own4[-2, 0] + own4[-2, 1] + own4[-2, 2] + own4[-1, -2] + own4[-1, -1] + own4[-1, 0] + own4[-1, 1] + own4[-1, 2] + own4[0, -2] + own4[0, -1] + own4 + own4[0, 1] + own4[0, 2] + own4[1, -2] + own4[1, -1] + own4[1, 0] + own4[1, 1] + own4[1, 2] + own4[2, -2] + own4[2, -1] + own4[2, 0] + own4[2, 1] + own4[2, 2]))
output a5 = 12 - relu(12 - (own5[-2, -2] + own5[-2, -1] + own5[-2, 0] + own5[-2, 1] + own5[-2, 2] + own5[-1, -2] + own5[-1, -1] + own5[-1, 0] + own5[-1, 1] + own5[-1, 2] + own5[0, -2] + own5[0, -1] + own5 + own5[0, 1] + own5[0, 2] + own5[1, -2] + own5[1, -1] + own5[1, 0] + own5[1, 1] + own5[1, 2] + own5[2, -2] + own5[2, -1] + own5[2, 0] + own5[2, 1] + own5[2, 2]))
output a6 = 12 - relu(12 - (own6[-2, -2] + own6[-2, -1] + own6[-2, 0] + own6[-2, 1] + own6[-2, 2] + own6[-1, -2] + own6[-1, -1] + own6[-1, 0] + own6[-1, 1] + own6[-1, 2] + own6[0, -2] + own6[0, -1] + own6 + own6[0, 1] + own6[0, 2] + own6[1, -2] + own6[1, -1] + own6[1, 0] + own6[1, 1] + own6[1, 2] + own6[2, -2] + own6[2, -1] + own6[2, 0] + own6[2, 1] + own6[2, 2]))
output a7 = 12 - relu(12 - (own7[-2, -2] + own7[-2, -1] + own7[-2, 0] + own7[-2, 1] + own7[-2, 2] + own7[-1, -2] + own7[-1, -1] + own7[-1, 0] + own7[-1, 1] + own7[-1, 2] + own7[0, -2] + own7[0, -1] + own7 + own7[0, 1] + own7[0, 2] + own7[1, -2] + own7[1, -1] + own7[1, 0] + own7[1, 1] + own7[1, 2] + own7[2, -2] + own7[2, -1] + own7[2, 0] + own7[2, 1] + own7[2, 2]))

# n: neighbours lying in each direction (cohesion and crowding)
output n0 = 16 - relu(16 - (crowd[-1, 2] + crowd[0, 1] + crowd[0, 2]))
output n1 = 16 - relu(16 - (crowd[-2, 1] + crowd[-2, 2] + crowd[-1, 1]))
output n2 = 16 - relu(16 - (crowd[-2, -1] + crowd[-2, 0] + crowd[-1, 0]))
output n3 = 16 - relu(16 - (crowd[-2, -2] + crowd[-1, -2] + crowd[-1, -1]))
output n4 = 16 - relu(16 - (crowd[0, -2] + crowd[0, -1] + crowd[1, -2]))
output n5 = 16 - relu(16 - (crowd[1, -1] + crowd[2, -2] + crowd[2, -1]))
output n6 = 16 - relu(16 - (crowd[1, 0] + crowd[2, 0] + crowd[2, 1]))
output n7 = 16 - relu(16 - (crowd[1, 1] + crowd[1, 2] + crowd[2, 2]))

# t: the other species in each direction
output t0 = 12 - relu(12 - (other[-1, 2] + other[0, 1] + other[0, 2]))
output t1 = 12 - relu(12 - (other[-2, 1] + other[-2, 2] + other[-1, 1]))
output t2 = 12 - relu(12 - (other[-2, -1] + other[-2, 0] + other[-1, 0]))
output t3 = 12 - relu(12 - (other[-2, -2] + other[-1, -2] + other[-1, -1]))
output t4 = 12 - relu(12 - (other[0, -2] + other[0, -1] + other[1, -2]))
output t5 = 12 - relu(12 - (other[1, -1] + other[2, -2] + other[2, -1]))
output t6 = 12 - relu(12 - (other[1, 0] + other[2, 0] + other[2, 1]))
output t7 = 12 - relu(12 - (other[1, 1] + other[1, 2] + other[2, 2]))

# b: blocked directions (a diagonal also when either side is)
output b0 = not(open[0, 1])
output b1 = not(and(open[-1, 1], open[-1, 0], open[0, 1]))
output b2 = not(open[-1, 0])
output b3 = not(and(open[-1, -1], open[-1, 0], open[0, -1]))
output b4 = not(open[0, -1])
output b5 = not(and(open[1, -1], open[1, 0], open[0, -1]))
output b6 = not(open[1, 0])
output b7 = not(and(open[1, 1], open[1, 0], open[0, 1]))

# g: 1 where a step lowers the distance to the goal, -1 where it raises it
output g0 = clip(dist - dist[0, 1], -1, 1)
output g1 = clip(dist - dist[-1, 1], -1, 1)
output g2 = clip(dist - dist[-1, 0], -1, 1)
output g3 = clip(dist - dist[-1, -1], -1, 1)
output g4 = clip(dist - dist[0, -1], -1, 1)
output g5 = clip(dist - dist[1, -1], -1, 1)
output g6 = clip(dist - dist[1, 0], -1, 1)
output g7 = clip(dist - dist[1, 1], -1, 1)
