wir 0.2
# Brain of one bird (generated by `wir swarm`): scores the 8 headings and takes the best.
# h is the current heading (one-hot), z a noise kick (one-hot or all 0), and a, n, t, b
# are the senses at the agent's cell. Blocked headings lose 113, more than the rest of
# the score can span, so a bird never picks a blocked heading while an open one exists.

input h0, h1, h2, h3, h4, h5, h6, h7: R1 in [0, 1]
input z0, z1, z2, z3, z4, z5, z6, z7: R1 in [0, 1]
input a0, a1, a2, a3, a4, a5, a6, a7: R1 in [0, 12]
input n0, n1, n2, n3, n4, n5, n6, n7: R1 in [0, 16]
input t0, t1, t2, t3, t4, t5, t6, t7: R1 in [0, 12]
input b0, b1, b2, b3, b4, b5, b6, b7: R1 in [0, 1]

# score of each heading: the straight part, then cohesion's bend (past `crowd`
# neighbours, each extra one costs). relu(x) - relu(-x) is x, kept as one value so the
# layers above carry 2 units per key instead of its 50 inputs. Times 8 plus a
# tie-break, so no two keys are equal.
let lin0 = 3*a0 + n0 + 2*t0 + 8*h0 + 4*h1 - 6*h3 - 12*h4 - 6*h5 + 4*h7 + 6*z0 - 113*b0
let lin1 = 3*a1 + n1 + 2*t1 + 4*h0 + 8*h1 + 4*h2 - 6*h4 - 12*h5 - 6*h6 + 6*z1 - 113*b1
let lin2 = 3*a2 + n2 + 2*t2 + 4*h1 + 8*h2 + 4*h3 - 6*h5 - 12*h6 - 6*h7 + 6*z2 - 113*b2
let lin3 = 3*a3 + n3 + 2*t3 - 6*h0 + 4*h2 + 8*h3 + 4*h4 - 6*h6 - 12*h7 + 6*z3 - 113*b3
let lin4 = 3*a4 + n4 + 2*t4 - 12*h0 - 6*h1 + 4*h3 + 8*h4 + 4*h5 - 6*h7 + 6*z4 - 113*b4
let lin5 = 3*a5 + n5 + 2*t5 - 6*h0 - 12*h1 - 6*h2 + 4*h4 + 8*h5 + 4*h6 + 6*z5 - 113*b5
let lin6 = 3*a6 + n6 + 2*t6 - 6*h1 - 12*h2 - 6*h3 + 4*h5 + 8*h6 + 4*h7 + 6*z6 - 113*b6
let lin7 = 3*a7 + n7 + 2*t7 + 4*h0 - 6*h2 - 12*h3 - 6*h4 + 4*h6 + 8*h7 + 6*z7 - 113*b7

let key0 = 8*(relu(lin0) - relu(-lin0) - 3*relu(n0 - 3)) + 7
let key1 = 8*(relu(lin1) - relu(-lin1) - 3*relu(n1 - 3)) + 6
let key2 = 8*(relu(lin2) - relu(-lin2) - 3*relu(n2 - 3)) + 5
let key3 = 8*(relu(lin3) - relu(-lin3) - 3*relu(n3 - 3)) + 4
let key4 = 8*(relu(lin4) - relu(-lin4) - 3*relu(n4 - 3)) + 3
let key5 = 8*(relu(lin5) - relu(-lin5) - 3*relu(n5 - 3)) + 2
let key6 = 8*(relu(lin6) - relu(-lin6) - 3*relu(n6 - 3)) + 1
let key7 = 8*(relu(lin7) - relu(-lin7) - 3*relu(n7 - 3)) + 0
let best = max(max(max(key0, key1), max(key2, key3)), max(max(key4, key5), max(key6, key7)))

output h2_0 = ge(key0, best)
output h2_1 = ge(key1, best)
output h2_2 = ge(key2, best)
output h2_3 = ge(key3, best)
output h2_4 = ge(key4, best)
output h2_5 = ge(key5, best)
output h2_6 = ge(key6, best)
output h2_7 = ge(key7, best)
