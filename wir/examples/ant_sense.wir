wir 0.2
# Senses of an ant (generated by `wir ant`). A grid program read at the ant's cell,
# side view (row 0 is the sky). Fields are 4-move distances over walkable cells: dn to
# the nest chamber, df to food one ant can lift, dg to the dig face, dm to the dump on
# the hill, dh to heavy items that need more ants. walk is 1 where an ant can stand
# (ants are small and pass one another), lift / pull / dig mark light items, heavy
# items still short of ants and soil the colony wants dug; fear is painted by the
# observer.
# Headings 0..3 are E N W S.

input dn: grid in [0, 120] pad 120
input df: grid in [0, 120] pad 120
input dg: grid in [0, 120] pad 120
input dm: grid in [0, 120] pad 120
input dh: grid in [0, 120] pad 120
input walk: grid in [0, 1] pad 0
input lift: grid in [0, 1] pad 0
input pull: grid in [0, 1] pad 0
input dig: grid in [0, 1] pad 0
input fear: grid in [0, 3] pad 0

# field grades: 1 when the neighbour is nearer the goal, -1 when farther
output gn0 = gt(dn, dn[0, 1]) - lt(dn, dn[0, 1])
output gn1 = gt(dn, dn[-1, 0]) - lt(dn, dn[-1, 0])
output gn2 = gt(dn, dn[0, -1]) - lt(dn, dn[0, -1])
output gn3 = gt(dn, dn[1, 0]) - lt(dn, dn[1, 0])
output gf0 = gt(df, df[0, 1]) - lt(df, df[0, 1])
output gf1 = gt(df, df[-1, 0]) - lt(df, df[-1, 0])
output gf2 = gt(df, df[0, -1]) - lt(df, df[0, -1])
output gf3 = gt(df, df[1, 0]) - lt(df, df[1, 0])
output gg0 = gt(dg, dg[0, 1]) - lt(dg, dg[0, 1])
output gg1 = gt(dg, dg[-1, 0]) - lt(dg, dg[-1, 0])
output gg2 = gt(dg, dg[0, -1]) - lt(dg, dg[0, -1])
output gg3 = gt(dg, dg[1, 0]) - lt(dg, dg[1, 0])
output gm0 = gt(dm, dm[0, 1]) - lt(dm, dm[0, 1])
output gm1 = gt(dm, dm[-1, 0]) - lt(dm, dm[-1, 0])
output gm2 = gt(dm, dm[0, -1]) - lt(dm, dm[0, -1])
output gm3 = gt(dm, dm[1, 0]) - lt(dm, dm[1, 0])
output gh0 = gt(dh, dh[0, 1]) - lt(dh, dh[0, 1])
output gh1 = gt(dh, dh[-1, 0]) - lt(dh, dh[-1, 0])
output gh2 = gt(dh, dh[0, -1]) - lt(dh, dh[0, -1])
output gh3 = gt(dh, dh[1, 0]) - lt(dh, dh[1, 0])

# blocked: nowhere to stand
output b0 = not(walk[0, 1])
output b1 = not(walk[-1, 0])
output b2 = not(walk[0, -1])
output b3 = not(walk[1, 0])

# fear grade: 1 when the neighbour is less frightening
output fg0 = gt(fear, fear[0, 1]) - lt(fear, fear[0, 1])
output fg1 = gt(fear, fear[-1, 0]) - lt(fear, fear[-1, 0])
output fg2 = gt(fear, fear[0, -1]) - lt(fear, fear[0, -1])
output fg3 = gt(fear, fear[1, 0]) - lt(fear, fear[1, 0])

# at the nest, at the dump; fields the ant can smell (below the ceiling)
output zn = le(dn, 0)
output zm = le(dm, 0)
output kn = lt(dn, 120)
output kf = lt(df, 120)
output kg = lt(dg, 120)
output kh = lt(dh, 120)

# next to a light item, a heavy item short of ants, soil to dig
output lf = or(lift[0, 1], lift[-1, 0], lift[0, -1], lift[1, 0])
output lp = or(pull[0, 1], pull[-1, 0], pull[0, -1], pull[1, 0])
output ld = or(dig[0, 1], dig[-1, 0], dig[0, -1], dig[1, 0])

# fear here, distance to the nest
output fs = fear
output dns = dn
