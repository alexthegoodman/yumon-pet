wir 0.2
# superpose-choice-layer: eat, hunt, flee, hide, mate, sleep, flock, roam, fight, brace share 6 neurons (PCA encoder, LP decoder, no training).
# On 92214 states (7751 distinct, weighted fight=30 brace=30 hide=10 mate=10): key0..key9 winner kept 93.12%; all outputs unchanged 0.00%.
# Brain of a Yumon (generated by `wir park`), one program for every species. It scores
# 10 options: eat hunt flee hide mate sleep flock roam fight brace. o is the current option. td fd pd md
# are the nearest threat, food, prey and mate as distance buckets (0 none, 1 far, 2 near,
# 3 close), kc the kin nearby; refuge = a band this Yumon can enter and the threat cannot.
# hit = how recently an attacker still in sight struck (3 just now), odds against it
# (0 worse, 1 even, 2 better). camo, social, armed and guard are traits. The host samples an option from a softmax over the
# keys; every Yumon starts from these weights and then learns its own.

input o0, o1, o2, o3, o4, o5, o6, o7, o8, o9: R1 in [0, 1]
input hunger: R1 in [0, 10]
input fatigue: R1 in [0, 10]
input hurt: R1 in [0, 3]
input fertile: R1 in [0, 1]
input td: R1 in [0, 3]
input refuge: R1 in [0, 1]
input fd: R1 in [0, 3]
input pd: R1 in [0, 3]
input md: R1 in [0, 3]
input kc: R1 in [0, 3]
input camo: R1 in [0, 1]
input social: R1 in [0, 1]
input hit: R1 in [0, 3]
input odds: R1 in [0, 2]
input armed: R1 in [0, 1]
input guard: R1 in [0, 1]

let scared = gt(td, 0)
# hunting comes first: prey in sight beats plants unless the prey is far and food close
let eat = select(and(gt(fd, 0), ge(hunger, 2)), hunger + 2*fd - 1, 0)
let hunt = select(and(gt(pd, 0), ge(hunger, 3)), hunger + 3*pd + 1, 0)
# flee harder when the threat is close, a refuge is reachable, or already hurt
let flee = select(scared, 3*td + 2*refuge + 2*hurt + 2, 0)
# camouflaged species freeze instead, until the threat is close
let hide = select(and(camo, scared, lt(td, 3)), 3*td + 6, 0)
# a far threat does not stop mating
let mate = select(and(fertile, gt(md, 0), lt(hunger, 6), lt(td, 2)), 6 + 2*md, 0)
let sleep = select(scared, 0, 2*clip(fatigue - 3, 0, 7))
# social species keep together, more so under threat
let flock = select(social, 2 + td - min(kc, 2), 0)
# roam: wander farther when hungry and nothing to eat or hunt is in sight
let roam = 2 + select(and(eq(fd, 0), eq(pd, 0)), min(hunger, 5), 0)
# struck: the armed fight back when the odds allow (less so when hurt); a shell or
# spines can brace instead, unless a refuge or being hurt makes fleeing better
let fight = select(and(armed, gt(hit, 0)), max(4*hit + 4*odds - 2*hurt - 2, 0), 0)
let brace = select(and(guard, ge(hit, 2)), 3*hit + 3, 0)
# --- superpose-choice-layer: 10 features share 6 neurons (PCA encoder, LP decoder) ---
let sp_z0 = unit(2.9958*eat + 9.481*hunt + 7.2298*flee - 1.0246*hide - 2.1947*mate - 1.5019*sleep + 1.8913*flock - 0.192*roam + 6.9626*fight + 6.6822*brace)
let sp_z1 = unit(-2.5681*eat - 9.1166*hunt + 10.8392*flee + 0.551*hide - 1.6818*mate - 6.581*sleep + 1.4823*flock + 0.0516*roam - 0.2837*fight + 0.2894*brace)
let sp_z2 = unit(-2.7985*eat - 7.0381*hunt - 5.1814*flee - 1.7521*hide + 0.3481*mate + 1.7453*sleep - 0.0392*flock - 0.007*roam + 12.0318*fight + 4.5588*brace)
let sp_z3 = unit(8.6042*eat - 5.1571*hunt + 0.5643*flee - 2.0209*hide - 6.7066*mate + 6.4665*sleep - 1.1983*flock - 0.2844*roam - 4.3263*fight + 6.6288*brace)
let sp_z4 = unit(-2.7691*eat - 0.4771*hunt + 1.9447*flee - 3.5799*hide + 11.5181*mate + 1.9371*sleep - 1.4667*flock - 0.2278*roam - 4.4627*fight + 8.5422*brace)
let sp_z5 = unit(11.5283*eat - 2.4447*hunt + 0.7648*flee + 4.9088*hide + 8.0894*mate - 1.8437*sleep - 0.1532*flock - 0.8727*roam + 3.5422*fight - 3.2048*brace)
let sp_eat = 0.0109*sp_z0 - 0.01*sp_z1 - 0.0123*sp_z2 + 0.0325*sp_z3 - 0.0135*sp_z4 + 0.0486*sp_z5 - 0.2055
let sp_hunt = 0.037*sp_z0 - 0.0356*sp_z1 - 0.0274*sp_z2 - 0.0202*sp_z3 - 0.0018*sp_z4 - 0.0098*sp_z5 - 0.0418
let sp_flee = 0.0286*sp_z0 + 0.0436*sp_z1 - 0.0197*sp_z2 + 0.0015*sp_z3 + 0.0081*sp_z4 + 0.0037*sp_z5 + 0.7336
let sp_hide = 0
let sp_mate = -0.0084*sp_z0 - 0.0063*sp_z1 + 0.0013*sp_z2 - 0.026*sp_z3 + 0.0442*sp_z4 + 0.0318*sp_z5 + 0.2722
let sp_sleep = -0.0054*sp_z0 - 0.0228*sp_z1 + 0.0075*sp_z2 + 0.0224*sp_z3 + 0.0084*sp_z4 - 0.0075*sp_z5 + 1.8748
let sp_flock = 0.0079*sp_z0 + 0.0072*sp_z1 - 0.0019*sp_z2 - 0.0028*sp_z3 - 0.0038*sp_z4 - 0.0004*sp_z5 + 0.225
let sp_roam = 2
let sp_fight = 0.0272*sp_z0 - 0.0009*sp_z1 + 0.0473*sp_z2 - 0.0167*sp_z3 - 0.018*sp_z4 + 0.0139*sp_z5 + 0.26
let sp_brace = 0.0265*sp_z0 + 0.0001*sp_z1 + 0.0184*sp_z2 + 0.0268*sp_z3 + 0.0367*sp_z4 - 0.0156*sp_z5 - 0.5153
# --- end of superpose-choice-layer ---

# keys: 16 * (drive + 2 on the current option) + a tie-break
output key0 = 16*sp_eat + 32*o0 + 9
output key1 = 16*sp_hunt + 32*o1 + 8
output key2 = 16*sp_flee + 32*o2 + 7
output key3 = 16*sp_hide + 32*o3 + 6
output key4 = 16*sp_mate + 32*o4 + 5
output key5 = 16*sp_sleep + 32*o5 + 4
output key6 = 16*sp_flock + 32*o6 + 3
output key7 = 16*sp_roam + 32*o7 + 2
output key8 = 16*sp_fight + 32*o8 + 1
output key9 = 16*sp_brace + 32*o9 + 0
