wir 0.2
# Armageddon 2070 fixed-wing brain: attack (generated by `wir armageddon`). Phases p0..p4: patrol,
# attack run, pull out, evade, return to base. The host flies the phase. tg a ground target is
# designated, air enemy aircraft near, aa anti-air near, tdist the target (100 m units), alt
# height (50 m units), payload a vehicle aboard (transport) and dz over the drop zone.
input p0, p1, p2, p3, p4: R1 in [0, 1]
input hp: R1 in [1, 10]
input ammo: R1 in [0, 6]
input tg: R1 in [0, 1]
input air: R1 in [0, 3]
input aa: R1 in [0, 3]
input lock: R1 in [0, 1]
input tdist: R1 in [0, 20]
input alt: R1 in [0, 6]
input flares: R1 in [0, 1]
input payload: R1 in [0, 1]
input dz: R1 in [0, 1]
let s0 = 3 + 2*p0
let s1 = select(ge(ammo, 1), 9*tg + 2*min(air, 1), 0) + 8*payload - 2*min(aa, 3) + 3*p1
let s2 = 9*and(p1, or(le(tdist, 1), le(alt, 1))) + 4*and(p2, le(alt, 3))
let s3 = 8*lock + 2*min(aa, 3) + 2*p3
let s4 = 7*and(le(ammo, 0), le(payload, 0)) + 6*le(hp, 3) + 2*p4
let phasekey0 = unit(5*(s0) + 4)
let phasekey1 = unit(5*(s1) + 3)
let phasekey2 = unit(5*(s2) + 2)
let phasekey3 = unit(5*(s3) + 1)
let phasekey4 = unit(5*(s4) + 0)
let phasew0_1 = gt(phasekey0, phasekey1)
let phasew0_2 = gt(phasekey0, phasekey2)
let phasew0_3 = gt(phasekey0, phasekey3)
let phasew0_4 = gt(phasekey0, phasekey4)
let phasew1_2 = gt(phasekey1, phasekey2)
let phasew1_3 = gt(phasekey1, phasekey3)
let phasew1_4 = gt(phasekey1, phasekey4)
let phasew2_3 = gt(phasekey2, phasekey3)
let phasew2_4 = gt(phasekey2, phasekey4)
let phasew3_4 = gt(phasekey3, phasekey4)
output phase0 = and(phasew0_1, phasew0_2, phasew0_3, phasew0_4)
output phase1 = and(not(phasew0_1), phasew1_2, phasew1_3, phasew1_4)
output phase2 = and(not(phasew0_2), not(phasew1_2), phasew2_3, phasew2_4)
output phase3 = and(not(phasew0_3), not(phasew1_3), not(phasew2_3), phasew3_4)
output phase4 = and(not(phasew0_4), not(phasew1_4), not(phasew2_4), not(phasew3_4))
output fire = and(p1, ge(ammo, 1), le(tdist, 10), or(tg, ge(air, 1)))
output flare = and(lock, flares)
output drop = or(and(payload, dz), and(p1, tg, le(tdist, 2), ge(ammo, 1)))
