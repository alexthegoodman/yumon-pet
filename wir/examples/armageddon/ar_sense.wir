wir 0.2
# Armageddon 2070 senses (generated by `wir armageddon`). A grid program read at an agent's
# cell; the host fills a 5 x 5 window around it. Distance fields are relative to the agent
# and clipped to [0, 48]: dobj to its objective, dthr to the nearest threat, dcov to cover,
# dlead to its squad anchor (leader, rally point or the squad it supports). exp is 1 where a
# known enemy sees the cell, wall 1 where the agent cannot go, ally 1 where a friend stands.
# Headings 0..7 are E NE N NW W SW S SE; a straight step costs 2, a diagonal 3.

input dobj: grid in [0, 48] pad 48
input dthr: grid in [0, 48] pad 48
input dcov: grid in [0, 48] pad 48
input dlead: grid in [0, 48] pad 48
input exp: grid in [0, 1] pad 0
input wall: grid in [0, 1] pad 1
input ally: grid in [0, 1] pad 0

# grades: 1 within 1 of the best neighbour, 0 within 3, -1 farther
let mo = min(dobj[0, 1], dobj[-1, 1], dobj[-1, 0], dobj[-1, -1], dobj[0, -1], dobj[1, -1], dobj[1, 0], dobj[1, 1])
let mt = min(dthr[0, 1], dthr[-1, 1], dthr[-1, 0], dthr[-1, -1], dthr[0, -1], dthr[1, -1], dthr[1, 0], dthr[1, 1])
let mc = min(dcov[0, 1], dcov[-1, 1], dcov[-1, 0], dcov[-1, -1], dcov[0, -1], dcov[1, -1], dcov[1, 0], dcov[1, 1])
let ml = min(dlead[0, 1], dlead[-1, 1], dlead[-1, 0], dlead[-1, -1], dlead[0, -1], dlead[1, -1], dlead[1, 0], dlead[1, 1])
output go0 = le(dobj[0, 1] - mo, 1) - ge(dobj[0, 1] - mo, 4)
output go1 = le(dobj[-1, 1] - mo, 1) - ge(dobj[-1, 1] - mo, 4)
output go2 = le(dobj[-1, 0] - mo, 1) - ge(dobj[-1, 0] - mo, 4)
output go3 = le(dobj[-1, -1] - mo, 1) - ge(dobj[-1, -1] - mo, 4)
output go4 = le(dobj[0, -1] - mo, 1) - ge(dobj[0, -1] - mo, 4)
output go5 = le(dobj[1, -1] - mo, 1) - ge(dobj[1, -1] - mo, 4)
output go6 = le(dobj[1, 0] - mo, 1) - ge(dobj[1, 0] - mo, 4)
output go7 = le(dobj[1, 1] - mo, 1) - ge(dobj[1, 1] - mo, 4)
output gt0 = le(dthr[0, 1] - mt, 1) - ge(dthr[0, 1] - mt, 4)
output gt1 = le(dthr[-1, 1] - mt, 1) - ge(dthr[-1, 1] - mt, 4)
output gt2 = le(dthr[-1, 0] - mt, 1) - ge(dthr[-1, 0] - mt, 4)
output gt3 = le(dthr[-1, -1] - mt, 1) - ge(dthr[-1, -1] - mt, 4)
output gt4 = le(dthr[0, -1] - mt, 1) - ge(dthr[0, -1] - mt, 4)
output gt5 = le(dthr[1, -1] - mt, 1) - ge(dthr[1, -1] - mt, 4)
output gt6 = le(dthr[1, 0] - mt, 1) - ge(dthr[1, 0] - mt, 4)
output gt7 = le(dthr[1, 1] - mt, 1) - ge(dthr[1, 1] - mt, 4)
output gc0 = le(dcov[0, 1] - mc, 1) - ge(dcov[0, 1] - mc, 4)
output gc1 = le(dcov[-1, 1] - mc, 1) - ge(dcov[-1, 1] - mc, 4)
output gc2 = le(dcov[-1, 0] - mc, 1) - ge(dcov[-1, 0] - mc, 4)
output gc3 = le(dcov[-1, -1] - mc, 1) - ge(dcov[-1, -1] - mc, 4)
output gc4 = le(dcov[0, -1] - mc, 1) - ge(dcov[0, -1] - mc, 4)
output gc5 = le(dcov[1, -1] - mc, 1) - ge(dcov[1, -1] - mc, 4)
output gc6 = le(dcov[1, 0] - mc, 1) - ge(dcov[1, 0] - mc, 4)
output gc7 = le(dcov[1, 1] - mc, 1) - ge(dcov[1, 1] - mc, 4)
output gl0 = le(dlead[0, 1] - ml, 1) - ge(dlead[0, 1] - ml, 4)
output gl1 = le(dlead[-1, 1] - ml, 1) - ge(dlead[-1, 1] - ml, 4)
output gl2 = le(dlead[-1, 0] - ml, 1) - ge(dlead[-1, 0] - ml, 4)
output gl3 = le(dlead[-1, -1] - ml, 1) - ge(dlead[-1, -1] - ml, 4)
output gl4 = le(dlead[0, -1] - ml, 1) - ge(dlead[0, -1] - ml, 4)
output gl5 = le(dlead[1, -1] - ml, 1) - ge(dlead[1, -1] - ml, 4)
output gl6 = le(dlead[1, 0] - ml, 1) - ge(dlead[1, 0] - ml, 4)
output gl7 = le(dlead[1, 1] - ml, 1) - ge(dlead[1, 1] - ml, 4)

# e: a known enemy sees the next cell
output e0 = exp[0, 1]
output e1 = exp[-1, 1]
output e2 = exp[-1, 0]
output e3 = exp[-1, -1]
output e4 = exp[0, -1]
output e5 = exp[1, -1]
output e6 = exp[1, 0]
output e7 = exp[1, 1]

# n: friends per pinwheel sector of the 5 x 5 window, capped at 3
output n0 = 3 - relu(3 - (ally[-1, 2] + ally[0, 1] + ally[0, 2]))
output n1 = 3 - relu(3 - (ally[-2, 1] + ally[-2, 2] + ally[-1, 1]))
output n2 = 3 - relu(3 - (ally[-2, -1] + ally[-2, 0] + ally[-1, 0]))
output n3 = 3 - relu(3 - (ally[-2, -2] + ally[-1, -2] + ally[-1, -1]))
output n4 = 3 - relu(3 - (ally[0, -2] + ally[0, -1] + ally[1, -2]))
output n5 = 3 - relu(3 - (ally[1, -1] + ally[2, -2] + ally[2, -1]))
output n6 = 3 - relu(3 - (ally[1, 0] + ally[2, 0] + ally[2, 1]))
output n7 = 3 - relu(3 - (ally[1, 1] + ally[1, 2] + ally[2, 2]))

# b: blocked by a wall or a friend; a diagonal also by a wall beside it
output b0 = or(wall[0, 1], ally[0, 1])
output b1 = or(wall[-1, 1], ally[-1, 1], wall[-1, 0], wall[0, 1])
output b2 = or(wall[-1, 0], ally[-1, 0])
output b3 = or(wall[-1, -1], ally[-1, -1], wall[-1, 0], wall[0, -1])
output b4 = or(wall[0, -1], ally[0, -1])
output b5 = or(wall[1, -1], ally[1, -1], wall[1, 0], wall[0, -1])
output b6 = or(wall[1, 0], ally[1, 0])
output b7 = or(wall[1, 1], ally[1, 1], wall[1, 0], wall[0, 1])

# the agent's own cell: seen, and how its cover compares with the best neighbour
output es = exp
output gcs = le(dcov - mc, 1) - ge(dcov - mc, 4)
