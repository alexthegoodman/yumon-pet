wir 0.2
# Armageddon 2070 transport brain: apc (generated by `wir armageddon`). Carries its squad to
# the objective (go grades), comes back for members not aboard (gl grades toward them), dismounts
# them near the objective, in a firefight or when badly hurt, and supports with its gun.
# pax aboard, wait members still to pick up, near some of them within 15 m.
input o0, o1, o2, o3, o4, o5, o6, o7, o8: R1 in [0, 1]
input hp: R1 in [1, 10]
input pax: R1 in [0, 6]
input wait: R1 in [0, 6]
input near: R1 in [0, 1]
input dobj: R1 in [0, 20]
input at: R1 in [0, 3]
input tanks: R1 in [0, 3]
input inf: R1 in [0, 8]
input tdist: R1 in [0, 40]
input vis: R1 in [0, 1]
input atgm: R1 in [0, 1]
input smoke: R1 in [0, 1]
input go0, go1, go2, go3, go4, go5, go6, go7: R1 in [-1, 1]
input gt0, gt1, gt2, gt3, gt4, gt5, gt6, gt7: R1 in [-1, 1]
input gc0, gc1, gc2, gc3, gc4, gc5, gc6, gc7: R1 in [-1, 1]
input gl0, gl1, gl2, gl3, gl4, gl5, gl6, gl7: R1 in [-1, 1]
input e0, e1, e2, e3, e4, e5, e6, e7: R1 in [0, 1]
input n0, n1, n2, n3, n4, n5, n6, n7: R1 in [0, 3]
input b0, b1, b2, b3, b4, b5, b6, b7: R1 in [0, 1]
input es: R1 in [0, 1]
input gcs: R1 in [-1, 1]
let fear = 2*relu(5 - hp) + 2*min(at, 3) + 3*min(tanks, 2) + min(pax, 3)
let approach = clip(tdist - 14 - fear, -3, 3)
let deliver = clip(3 + min(pax, 3) - fear + 2*le(wait, 0), 0, 6)
let pickup = select(le(pax, 0), clip(2*min(wait, 3), 0, 6), 0)
let cover = clip(fear - 2, 0, 6)
let peek = clip(2 - fear, -3, 2)
let plant = 6*and(near, ge(wait, 1)) + 3*and(es, vis, le(tdist, 32))
let k0 = unit(-2*n0 + 3*o0 + o1 - o3 - 3*o4 - o5 + o7 - 60*b0)
let k1 = unit(-2*n1 + o0 + 3*o1 + o2 - o4 - 3*o5 - o6 - 60*b1)
let k2 = unit(-2*n2 + o1 + 3*o2 + o3 - o5 - 3*o6 - o7 - 60*b2)
let k3 = unit(-2*n3 - o0 + o2 + 3*o3 + o4 - o6 - 3*o7 - 60*b3)
let k4 = unit(-2*n4 - 3*o0 - o1 + o3 + 3*o4 + o5 - o7 - 60*b4)
let k5 = unit(-2*n5 - o0 - 3*o1 - o2 + o4 + 3*o5 + o6 - 60*b5)
let k6 = unit(-2*n6 - o1 - 3*o2 - o3 + o5 + 3*o6 + o7 - 60*b6)
let k7 = unit(-2*n7 + o0 - o2 - 3*o3 - o4 + o6 + 3*o7 - 60*b7)
let k8 = unit(o8)
let s0 = approach*gt0 + deliver*go0 + pickup*gl0 + cover*gc0 + peek*e0 + k0
let s1 = approach*gt1 + deliver*go1 + pickup*gl1 + cover*gc1 + peek*e1 + k1
let s2 = approach*gt2 + deliver*go2 + pickup*gl2 + cover*gc2 + peek*e2 + k2
let s3 = approach*gt3 + deliver*go3 + pickup*gl3 + cover*gc3 + peek*e3 + k3
let s4 = approach*gt4 + deliver*go4 + pickup*gl4 + cover*gc4 + peek*e4 + k4
let s5 = approach*gt5 + deliver*go5 + pickup*gl5 + cover*gc5 + peek*e5 + k5
let s6 = approach*gt6 + deliver*go6 + pickup*gl6 + cover*gc6 + peek*e6 + k6
let s7 = approach*gt7 + deliver*go7 + pickup*gl7 + cover*gc7 + peek*e7 + k7
let s8 = cover*gcs + peek*es + plant + k8
let o2_key0 = unit(9*(s0) + 8)
let o2_key1 = unit(9*(s1) + 7)
let o2_key2 = unit(9*(s2) + 6)
let o2_key3 = unit(9*(s3) + 5)
let o2_key4 = unit(9*(s4) + 4)
let o2_key5 = unit(9*(s5) + 3)
let o2_key6 = unit(9*(s6) + 2)
let o2_key7 = unit(9*(s7) + 1)
let o2_key8 = unit(9*(s8) + 0)
let o2_w0_1 = gt(o2_key0, o2_key1)
let o2_w0_2 = gt(o2_key0, o2_key2)
let o2_w0_3 = gt(o2_key0, o2_key3)
let o2_w0_4 = gt(o2_key0, o2_key4)
let o2_w0_5 = gt(o2_key0, o2_key5)
let o2_w0_6 = gt(o2_key0, o2_key6)
let o2_w0_7 = gt(o2_key0, o2_key7)
let o2_w0_8 = gt(o2_key0, o2_key8)
let o2_w1_2 = gt(o2_key1, o2_key2)
let o2_w1_3 = gt(o2_key1, o2_key3)
let o2_w1_4 = gt(o2_key1, o2_key4)
let o2_w1_5 = gt(o2_key1, o2_key5)
let o2_w1_6 = gt(o2_key1, o2_key6)
let o2_w1_7 = gt(o2_key1, o2_key7)
let o2_w1_8 = gt(o2_key1, o2_key8)
let o2_w2_3 = gt(o2_key2, o2_key3)
let o2_w2_4 = gt(o2_key2, o2_key4)
let o2_w2_5 = gt(o2_key2, o2_key5)
let o2_w2_6 = gt(o2_key2, o2_key6)
let o2_w2_7 = gt(o2_key2, o2_key7)
let o2_w2_8 = gt(o2_key2, o2_key8)
let o2_w3_4 = gt(o2_key3, o2_key4)
let o2_w3_5 = gt(o2_key3, o2_key5)
let o2_w3_6 = gt(o2_key3, o2_key6)
let o2_w3_7 = gt(o2_key3, o2_key7)
let o2_w3_8 = gt(o2_key3, o2_key8)
let o2_w4_5 = gt(o2_key4, o2_key5)
let o2_w4_6 = gt(o2_key4, o2_key6)
let o2_w4_7 = gt(o2_key4, o2_key7)
let o2_w4_8 = gt(o2_key4, o2_key8)
let o2_w5_6 = gt(o2_key5, o2_key6)
let o2_w5_7 = gt(o2_key5, o2_key7)
let o2_w5_8 = gt(o2_key5, o2_key8)
let o2_w6_7 = gt(o2_key6, o2_key7)
let o2_w6_8 = gt(o2_key6, o2_key8)
let o2_w7_8 = gt(o2_key7, o2_key8)
output o2_0 = and(o2_w0_1, o2_w0_2, o2_w0_3, o2_w0_4, o2_w0_5, o2_w0_6, o2_w0_7, o2_w0_8)
output o2_1 = and(not(o2_w0_1), o2_w1_2, o2_w1_3, o2_w1_4, o2_w1_5, o2_w1_6, o2_w1_7, o2_w1_8)
output o2_2 = and(not(o2_w0_2), not(o2_w1_2), o2_w2_3, o2_w2_4, o2_w2_5, o2_w2_6, o2_w2_7, o2_w2_8)
output o2_3 = and(not(o2_w0_3), not(o2_w1_3), not(o2_w2_3), o2_w3_4, o2_w3_5, o2_w3_6, o2_w3_7, o2_w3_8)
output o2_4 = and(not(o2_w0_4), not(o2_w1_4), not(o2_w2_4), not(o2_w3_4), o2_w4_5, o2_w4_6, o2_w4_7, o2_w4_8)
output o2_5 = and(not(o2_w0_5), not(o2_w1_5), not(o2_w2_5), not(o2_w3_5), not(o2_w4_5), o2_w5_6, o2_w5_7, o2_w5_8)
output o2_6 = and(not(o2_w0_6), not(o2_w1_6), not(o2_w2_6), not(o2_w3_6), not(o2_w4_6), not(o2_w5_6), o2_w6_7, o2_w6_8)
output o2_7 = and(not(o2_w0_7), not(o2_w1_7), not(o2_w2_7), not(o2_w3_7), not(o2_w4_7), not(o2_w5_7), not(o2_w6_7), o2_w7_8)
output o2_8 = and(not(o2_w0_8), not(o2_w1_8), not(o2_w2_8), not(o2_w3_8), not(o2_w4_8), not(o2_w5_8), not(o2_w6_8), not(o2_w7_8))
output dismount = and(ge(pax, 1), or(le(dobj, 2), and(le(tdist, 8), ge(inf, 1)), le(hp, 3)))
output fire = and(vis, le(tdist, 32))
output atgm2 = and(atgm, vis, ge(tanks, 1), le(tdist, 40))
output smoke2 = and(smoke, vis, or(ge(at, 1), le(hp, 4)))
