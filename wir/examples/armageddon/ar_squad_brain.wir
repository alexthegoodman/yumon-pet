wir 0.2
# Armageddon 2070 squad brain (generated by `wir armageddon`): the squad's mode.
# c: current mode (advance, assault, defend, regroup, flank, fall back, mount). alive and hp
# (mean, 0..10) measure strength; contact enemies seen, armor enemy vehicles seen, farmor a
# friendly vehicle with the squad; dobj the objective's distance (25 m units); ow0..ow2 who holds
# it (enemy, nobody, us); cont it is being contested; spread the squad's radius (5 m units);
# call the player called the squad; veh an empty friendly transport is near; mounted aboard.
input c0, c1, c2, c3, c4, c5, c6: R1 in [0, 1]
input alive: R1 in [0, 8]
input hp: R1 in [0, 10]
input contact: R1 in [0, 8]
input armor: R1 in [0, 3]
input farmor: R1 in [0, 1]
input dobj: R1 in [0, 20]
input ow0, ow1, ow2: R1 in [0, 1]
input cont: R1 in [0, 1]
input supp: R1 in [0, 4]
input spread: R1 in [0, 10]
input call: R1 in [0, 1]
input veh: R1 in [0, 1]
input mounted: R1 in [0, 1]
let strength = alive + hp
let danger = min(contact, 6) + 3*armor - 2*farmor + supp
let s0 = 4 + min(dobj, 8) - 2*min(contact, 3) - 3*ow2 + 2*c0
let s1 = select(and(le(dobj, 3), not(ow2)), 6 + min(contact, 3) + 2*cont, 0) + 2*c1
let s2 = 3*ow2 + 4*and(ow2, or(cont, ge(contact, 1))) + 2*and(ow2, le(dobj, 2)) + 2*c2
let s3 = clip(spread - 4, 0, 6) + 14*call + 3*le(alive, 3) + 2*c3
let s4 = select(and(ge(contact, 2), le(dobj, 8), ge(strength, 12), le(armor, 0)), 5 + min(contact, 3), 0) + 2*c4
let s5 = clip(danger + 6 - strength, 0, 12) + 2*c5
let s6 = 7*and(veh, ge(dobj, 10), not(mounted)) + 9*and(mounted, ge(dobj, 4)) + 2*c6
let modekey0 = unit(7*(s0) + 6)
let modekey1 = unit(7*(s1) + 5)
let modekey2 = unit(7*(s2) + 4)
let modekey3 = unit(7*(s3) + 3)
let modekey4 = unit(7*(s4) + 2)
let modekey5 = unit(7*(s5) + 1)
let modekey6 = unit(7*(s6) + 0)
let modew0_1 = gt(modekey0, modekey1)
let modew0_2 = gt(modekey0, modekey2)
let modew0_3 = gt(modekey0, modekey3)
let modew0_4 = gt(modekey0, modekey4)
let modew0_5 = gt(modekey0, modekey5)
let modew0_6 = gt(modekey0, modekey6)
let modew1_2 = gt(modekey1, modekey2)
let modew1_3 = gt(modekey1, modekey3)
let modew1_4 = gt(modekey1, modekey4)
let modew1_5 = gt(modekey1, modekey5)
let modew1_6 = gt(modekey1, modekey6)
let modew2_3 = gt(modekey2, modekey3)
let modew2_4 = gt(modekey2, modekey4)
let modew2_5 = gt(modekey2, modekey5)
let modew2_6 = gt(modekey2, modekey6)
let modew3_4 = gt(modekey3, modekey4)
let modew3_5 = gt(modekey3, modekey5)
let modew3_6 = gt(modekey3, modekey6)
let modew4_5 = gt(modekey4, modekey5)
let modew4_6 = gt(modekey4, modekey6)
let modew5_6 = gt(modekey5, modekey6)
output mode0 = and(modew0_1, modew0_2, modew0_3, modew0_4, modew0_5, modew0_6)
output mode1 = and(not(modew0_1), modew1_2, modew1_3, modew1_4, modew1_5, modew1_6)
output mode2 = and(not(modew0_2), not(modew1_2), modew2_3, modew2_4, modew2_5, modew2_6)
output mode3 = and(not(modew0_3), not(modew1_3), not(modew2_3), modew3_4, modew3_5, modew3_6)
output mode4 = and(not(modew0_4), not(modew1_4), not(modew2_4), not(modew3_4), modew4_5, modew4_6)
output mode5 = and(not(modew0_5), not(modew1_5), not(modew2_5), not(modew3_5), not(modew4_5), modew5_6)
output mode6 = and(not(modew0_6), not(modew1_6), not(modew2_6), not(modew3_6), not(modew4_6), not(modew5_6))
