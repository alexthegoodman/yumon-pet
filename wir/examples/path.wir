wir 0.2
# One value-iteration step for grid pathfinding (path_n4_m64_t1, generated by `wir path`).
# The program is one cell's rule; the compiler runs it at every cell (a convolution).
# d is the distance field: 0 at a goal, 64 for walls, unreachable cells and anything
# 64 or more away. Repeating the step from any field converges to shortest paths.
# Outside the grid, d reads 64 and wall reads 1.

input d: grid in [0, 64] pad 64
input wall: grid in [0, 1] pad 1
input goal: grid in [0, 1] pad 0

# the cheapest neighbour, as a two-level min tree
let best = min(min(d[-1, 0], d[1, 0]), min(d[0, -1], d[0, 1]))

# goals are 0, walls the ceiling, everything else one step past its best neighbour
output d2 = clip(1 + best + 64*wall - 129*goal, 0, 64)
