wir 0.2
# Brain of a rusher (generated by `wir tactics`): response curves, then a score for each
# heading (0..7: E NE N NW W SW S SE) and for holding still (8), the best one-hot, and
# whether to fire or reload. o is the current option (one-hot); the senses come from the
# sense program at the enemy's cell. Distances are field units (2 per straight cell).
# Reloading drops the magazine, so ammo is 0 until a reload is done.

input o0, o1, o2, o3, o4, o5, o6, o7, o8: R1 in [0, 1]
input hp: R1 in [1, 12]
input ammo: R1 in [0, 6]
input cool: R1 in [0, 2]
input reload: R1 in [0, 4]
input gp0, gp1, gp2, gp3, gp4, gp5, gp6, gp7: R1 in [-1, 1]
input gc0, gc1, gc2, gc3, gc4, gc5, gc6, gc7: R1 in [-1, 1]
input e0, e1, e2, e3, e4, e5, e6, e7: R1 in [0, 1]
input n0, n1, n2, n3, n4, n5, n6, n7: R1 in [0, 4]
input b0, b1, b2, b3, b4, b5, b6, b7: R1 in [0, 1]
input dp: R1 in [0, 96]
input es: R1 in [0, 1]
input gcs: R1 in [-1, 1]

# --- response curves ---
let empty = relu(1 - ammo)
# fear rises below 3 hp, faster below 0, and a lot while empty
let fear = relu(3 - hp) + 2*empty
# approach: + to close in, - to back off; fear pushes the preferred range out
let approach = clip(dp - 0 - fear, -6, 6)
# cover: the pull toward cells the player cannot see
let cover = clip(fear - 6, 0, 4)
# exposure: worth seeking when calm, avoided when afraid (empty is always -0)
let peek = clip(1 - fear, -0, 1)
# plant: hold still and fire when seen, loaded and in range but not too close
let plant = 2*and(es, ge(ammo, 1), le(dp, 3), ge(dp, 0))

# --- scores. Gradients gp, gc are -1, 0 or 1 and e is 0 or 1, so drive * gradient is
# an exact product. The rest of each score (spacing, keeping the current option, a
# blocked heading losing 32) is packed into one unit: relu(x - lo) + lo is x.
let k0 = relu(-n0 + 3*o0 + o1 - o3 - 3*o4 - o5 + o7 - 32*b0 + 39) - 39
let k1 = relu(-n1 + o0 + 3*o1 + o2 - o4 - 3*o5 - o6 - 32*b1 + 39) - 39
let k2 = relu(-n2 + o1 + 3*o2 + o3 - o5 - 3*o6 - o7 - 32*b2 + 39) - 39
let k3 = relu(-n3 - o0 + o2 + 3*o3 + o4 - o6 - 3*o7 - 32*b3 + 39) - 39
let k4 = relu(-n4 - 3*o0 - o1 + o3 + 3*o4 + o5 - o7 - 32*b4 + 39) - 39
let k5 = relu(-n5 - o0 - 3*o1 - o2 + o4 + 3*o5 + o6 - 32*b5 + 39) - 39
let k6 = relu(-n6 - o1 - 3*o2 - o3 + o5 + 3*o6 + o7 - 32*b6 + 39) - 39
let k7 = relu(-n7 + o0 - o2 - 3*o3 - o4 + o6 + 3*o7 - 32*b7 + 39) - 39
let k8 = 0

let s0 = approach*gp0 + cover*gc0 + peek*e0 + k0
let s1 = approach*gp1 + cover*gc1 + peek*e1 + k1
let s2 = approach*gp2 + cover*gc2 + peek*e2 + k2
let s3 = approach*gp3 + cover*gc3 + peek*e3 + k3
let s4 = approach*gp4 + cover*gc4 + peek*e4 + k4
let s5 = approach*gp5 + cover*gc5 + peek*e5 + k5
let s6 = approach*gp6 + cover*gc6 + peek*e6 + k6
let s7 = approach*gp7 + cover*gc7 + peek*e7 + k7
let s8 = cover*gcs + peek*es + plant + k8

# key: the score as one unit (scores are at least -49), times 9 plus a tie-break
let key0 = 9*relu(s0 + 49) - 433
let key1 = 9*relu(s1 + 49) - 434
let key2 = 9*relu(s2 + 49) - 435
let key3 = 9*relu(s3 + 49) - 436
let key4 = 9*relu(s4 + 49) - 437
let key5 = 9*relu(s5 + 49) - 438
let key6 = 9*relu(s6 + 49) - 439
let key7 = 9*relu(s7 + 49) - 440
let key8 = 9*relu(s8 + 49) - 441

# the best option beats every other key (keys are never equal)
let w01 = gt(key0, key1)
let w02 = gt(key0, key2)
let w03 = gt(key0, key3)
let w04 = gt(key0, key4)
let w05 = gt(key0, key5)
let w06 = gt(key0, key6)
let w07 = gt(key0, key7)
let w08 = gt(key0, key8)
let w12 = gt(key1, key2)
let w13 = gt(key1, key3)
let w14 = gt(key1, key4)
let w15 = gt(key1, key5)
let w16 = gt(key1, key6)
let w17 = gt(key1, key7)
let w18 = gt(key1, key8)
let w23 = gt(key2, key3)
let w24 = gt(key2, key4)
let w25 = gt(key2, key5)
let w26 = gt(key2, key6)
let w27 = gt(key2, key7)
let w28 = gt(key2, key8)
let w34 = gt(key3, key4)
let w35 = gt(key3, key5)
let w36 = gt(key3, key6)
let w37 = gt(key3, key7)
let w38 = gt(key3, key8)
let w45 = gt(key4, key5)
let w46 = gt(key4, key6)
let w47 = gt(key4, key7)
let w48 = gt(key4, key8)
let w56 = gt(key5, key6)
let w57 = gt(key5, key7)
let w58 = gt(key5, key8)
let w67 = gt(key6, key7)
let w68 = gt(key6, key8)
let w78 = gt(key7, key8)
output o2_0 = and(w01, w02, w03, w04, w05, w06, w07, w08)
output o2_1 = and(not(w01), w12, w13, w14, w15, w16, w17, w18)
output o2_2 = and(not(w02), not(w12), w23, w24, w25, w26, w27, w28)
output o2_3 = and(not(w03), not(w13), not(w23), w34, w35, w36, w37, w38)
output o2_4 = and(not(w04), not(w14), not(w24), not(w34), w45, w46, w47, w48)
output o2_5 = and(not(w05), not(w15), not(w25), not(w35), not(w45), w56, w57, w58)
output o2_6 = and(not(w06), not(w16), not(w26), not(w36), not(w46), not(w56), w67, w68)
output o2_7 = and(not(w07), not(w17), not(w27), not(w37), not(w47), not(w57), not(w67), w78)
output o2_8 = and(not(w08), not(w18), not(w28), not(w38), not(w48), not(w58), not(w68), not(w78))

# fire when the player is visible and in range; reload when empty, or hidden and low
output fire = and(es, ge(ammo, 1), le(cool, 0), le(dp, 3))
output reload2 = and(le(reload, 0), or(le(ammo, 0), and(not(es), le(ammo, 0))))
