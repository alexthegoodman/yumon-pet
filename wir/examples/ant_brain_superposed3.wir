wir 0.2
# Lossy superposition (docs/POLYSEMANTIC.md "Results"): ant_brain.wir with ten task/emote features
# (home forage dig dump help lost hungry workem cf grip) squeezed through 3 shared neurons z0..z2
# and read back linearly (r_*). C and D were fitted on colony states by wir/scripts/superpose/fit.py.
# Fear, action bits, inertia and gradient routing are unchanged from ant_brain.wir.
# In the colony (10k ticks, 3 seeds) 5.7-6.2% of decisions differ from the rule.
#
# Brain of an ant (generated by `wir ant`): response curves over its own state, five
# action bits, a score for each heading (0..3: E N W S) and for holding (4), the best
# option one-hot, and an emote one-hot (calm hungry working carrying straining scared
# curious) that the page shows as the ant's colour. o is the current option, w the
# wander heading the host turns now and then; the senses come from the sense program.

input o0, o1, o2, o3, o4: R1 in [0, 1]
input cf: R1 in [0, 1]
input cs: R1 in [0, 1]
input gr: R1 in [0, 1]
input hunger: R1 in [0, 15]
input old: R1 in [0, 1]
input store: R1 in [0, 3]
input w0, w1, w2, w3: R1 in [0, 1]
input r0, r1, r2: R1 in [0, 1]
input gn0, gn1, gn2, gn3, gf0, gf1, gf2, gf3, gg0, gg1, gg2, gg3, gm0, gm1, gm2, gm3, gh0, gh1, gh2, gh3: R1 in [-1, 1]
input b0, b1, b2, b3: R1 in [0, 1]
input fg0, fg1, fg2, fg3: R1 in [-1, 1]
input zn, zm, kn, kf, kg, kh, lf, lp, ld: R1 in [0, 1]
input fs: R1 in [0, 3]
input dns: R1 in [0, 120]

# --- state ---
let free = and(not(cf), not(cs), not(gr))
let hungry = clip(hunger - 5, 0, 10)
let starving = ge(hunger, 12)
let scared = ge(fs, 1)
let hs = ge(store, 1)
let idle = and(free, not(kf), not(kg), not(kh))

# --- response curves ---
# home: bring food back; go eat when hungry and the store has food; come back from afar
let home = select(kn, 6*cf + select(hs, 2*min(hungry, 4), 0) + 4*and(free, ge(dns, 60)), 0)
# roles r0 r1 r2 (digger, forager, helper) are individual thresholds: each adds 3 to its drive
# forage: more when the store is low, old ants forage more; hungrier if the store is empty
let fb = and(free, kf)
let fb2 = and(free, kf, not(hs))
let forage = select(fb, 5 - store + 2*old + 3*r1, 0) + select(fb2, min(hungry, 4), 0)
# dig: young ants dig more; nobody digs while starving
let dig = select(and(free, kg, not(starving)), 4 - 2*old + 3*r0, 0)
let dump = 6*and(cs, kn)
let help = select(and(free, kh, not(starving)), 3 + 3*r2, 0)
let explore = 3*or(idle, not(kn))
let flee = 8*scared

# --- actions ---
output pick = and(free, lf, not(scared))
output dig2 = and(free, ld, not(starving), not(scared))
output grip = and(or(gr, and(free, lp)), not(starving), not(scared))
output drop = or(and(cf, zn), and(cs, zm))
output eat = or(and(zn, hs, ge(hunger, 6)), and(cf, starving))
let work = or(gr, pick, dig2, grip, drop, eat)

# --- task: the strongest drive (ties to the lower index) ---
# --- superposition bottleneck: ten features share 3 neurons ---
let sp_lost = or(idle, not(kn))
let sp_work = or(cs, dig2, and(free, kg))
let z0 = unit(relu(0.56 - 0.01*home - 0.09*forage + 0.01*dig - 0.02*dump - 0.05*help - 0.56*sp_lost - 0.1*hungry + 0.87*sp_work - 0.65*cf + 0.29*grip))
let z1 = unit(relu(0.46 - 0.02*home + 0.06*forage + 0.02*dig - 0.1*dump - 0.04*help - 0.4*sp_lost - 0.01*hungry - 0.05*sp_work - 0.31*cf - 0.48*grip))
let z2 = unit(relu(0.52 - 0.02*home - 0.01*forage - 0.06*dig + 0.04*help + 0.1*sp_lost - 0.1*hungry + 0.24*sp_work - 0.44*cf - 0.36*grip))
let r_home = 3.4 - 0.64*z0 + 4.55*z1 - 4.32*z2
let r_forage = 0.01 - 0.7*z0 + 10.33*z1 - 2.36*z2
let r_dig = -2.03 + 4.88*z0 + 9.5*z1 - 6.96*z2
let r_dump = -0.33 + 1.65*z0 - 1.79*z1 + 0.67*z2
let r_help = 2.38 - 0.55*z0 + 3.53*z1 - 0.12*z2
let r_lost = 1.25 - 0.68*z0 - 1.88*z1 + 0.04*z2
let r_hungry = 4.15 + 0.41*z0 - 2.08*z1 - 5.38*z2
let r_workem = -0.25 + 1.34*z0 + 0.74*z1 - 0.22*z2
let r_cf = 1.15 - 0.45*z0 - 1*z1 - 1.74*z2
let r_grip = 0.84 + 0.41*z0 - 1.21*z1 - 1.29*z2
let tkey0 = 7*r_home + 6
let tkey1 = 7*r_forage + 5
let tkey2 = 7*r_dig + 4
let tkey3 = 7*r_dump + 3
let tkey4 = 7*r_help + 2
let tkey5 = 21*r_lost + 1
let tkey6 = 7*flee + 0
let tw0_1 = gt(tkey0, tkey1)
let tw0_2 = gt(tkey0, tkey2)
let tw0_3 = gt(tkey0, tkey3)
let tw0_4 = gt(tkey0, tkey4)
let tw0_5 = gt(tkey0, tkey5)
let tw0_6 = gt(tkey0, tkey6)
let tw1_2 = gt(tkey1, tkey2)
let tw1_3 = gt(tkey1, tkey3)
let tw1_4 = gt(tkey1, tkey4)
let tw1_5 = gt(tkey1, tkey5)
let tw1_6 = gt(tkey1, tkey6)
let tw2_3 = gt(tkey2, tkey3)
let tw2_4 = gt(tkey2, tkey4)
let tw2_5 = gt(tkey2, tkey5)
let tw2_6 = gt(tkey2, tkey6)
let tw3_4 = gt(tkey3, tkey4)
let tw3_5 = gt(tkey3, tkey5)
let tw3_6 = gt(tkey3, tkey6)
let tw4_5 = gt(tkey4, tkey5)
let tw4_6 = gt(tkey4, tkey6)
let tw5_6 = gt(tkey5, tkey6)
let task0 = and(tw0_1, tw0_2, tw0_3, tw0_4, tw0_5, tw0_6)
let task1 = and(not(tw0_1), tw1_2, tw1_3, tw1_4, tw1_5, tw1_6)
let task2 = and(not(tw0_2), not(tw1_2), tw2_3, tw2_4, tw2_5, tw2_6)
let task3 = and(not(tw0_3), not(tw1_3), not(tw2_3), tw3_4, tw3_5, tw3_6)
let task4 = and(not(tw0_4), not(tw1_4), not(tw2_4), not(tw3_4), tw4_5, tw4_6)
let task5 = and(not(tw0_5), not(tw1_5), not(tw2_5), not(tw3_5), not(tw4_5), tw5_6)
let task6 = and(not(tw0_6), not(tw1_6), not(tw2_6), not(tw3_6), not(tw4_6), not(tw5_6))

# --- scores: 4 along the task's field (grades are -1, 0 or 1, so task * grade is an
# exact product). Inertia and a blocked heading losing 15 are packed into one unit. ---
let k0 = relu(2*o0 - 2*o2 - 15*b0 + 17) - 17
let k1 = relu(2*o1 - 2*o3 - 15*b1 + 17) - 17
let k2 = relu(-2*o0 + 2*o2 - 15*b2 + 17) - 17
let k3 = relu(-2*o1 + 2*o3 - 15*b3 + 17) - 17
let k4 = relu(o4)

let s0 = 4*(task0*gn0 + task1*gf0 + task2*gg0 + task3*gm0 + task4*gh0 + task5*w0 + task6*fg0) + k0
let s1 = 4*(task0*gn1 + task1*gf1 + task2*gg1 + task3*gm1 + task4*gh1 + task5*w1 + task6*fg1) + k1
let s2 = 4*(task0*gn2 + task1*gf2 + task2*gg2 + task3*gm2 + task4*gh2 + task5*w2 + task6*fg2) + k2
let s3 = 4*(task0*gn3 + task1*gf3 + task2*gg3 + task3*gm3 + task4*gh3 + task5*w3 + task6*fg3) + k3
let s4 = 7*work + k4

# key: the score as one unit (scores are at least -21), times 5 plus a tie-break
let key0 = 5*relu(s0 + 21) - 101
let key1 = 5*relu(s1 + 21) - 102
let key2 = 5*relu(s2 + 21) - 103
let key3 = 5*relu(s3 + 21) - 104
let key4 = 5*relu(s4 + 21) - 105

# the best option beats every other key
let w0_1 = gt(key0, key1)
let w0_2 = gt(key0, key2)
let w0_3 = gt(key0, key3)
let w0_4 = gt(key0, key4)
let w1_2 = gt(key1, key2)
let w1_3 = gt(key1, key3)
let w1_4 = gt(key1, key4)
let w2_3 = gt(key2, key3)
let w2_4 = gt(key2, key4)
let w3_4 = gt(key3, key4)
output o2_0 = and(w0_1, w0_2, w0_3, w0_4)
output o2_1 = and(not(w0_1), w1_2, w1_3, w1_4)
output o2_2 = and(not(w0_2), not(w1_2), w2_3, w2_4)
output o2_3 = and(not(w0_3), not(w1_3), not(w2_3), w3_4)
output o2_4 = and(not(w0_4), not(w1_4), not(w2_4), not(w3_4))

# --- emote: the strongest feeling (ties to the lower index) ---
let ekey0 = 7*(1) + 6
let ekey1 = 7*r_hungry + 5
let ekey2 = 21*r_workem + 4
let ekey3 = 28*r_cf + 3
let ekey4 = 35*r_grip + 2
let ekey5 = 7*(9*scared) + 1
let ekey6 = 14*r_lost
let ew0_1 = gt(ekey0, ekey1)
let ew0_2 = gt(ekey0, ekey2)
let ew0_3 = gt(ekey0, ekey3)
let ew0_4 = gt(ekey0, ekey4)
let ew0_5 = gt(ekey0, ekey5)
let ew0_6 = gt(ekey0, ekey6)
let ew1_2 = gt(ekey1, ekey2)
let ew1_3 = gt(ekey1, ekey3)
let ew1_4 = gt(ekey1, ekey4)
let ew1_5 = gt(ekey1, ekey5)
let ew1_6 = gt(ekey1, ekey6)
let ew2_3 = gt(ekey2, ekey3)
let ew2_4 = gt(ekey2, ekey4)
let ew2_5 = gt(ekey2, ekey5)
let ew2_6 = gt(ekey2, ekey6)
let ew3_4 = gt(ekey3, ekey4)
let ew3_5 = gt(ekey3, ekey5)
let ew3_6 = gt(ekey3, ekey6)
let ew4_5 = gt(ekey4, ekey5)
let ew4_6 = gt(ekey4, ekey6)
let ew5_6 = gt(ekey5, ekey6)
output em0 = and(ew0_1, ew0_2, ew0_3, ew0_4, ew0_5, ew0_6)
output em1 = and(not(ew0_1), ew1_2, ew1_3, ew1_4, ew1_5, ew1_6)
output em2 = and(not(ew0_2), not(ew1_2), ew2_3, ew2_4, ew2_5, ew2_6)
output em3 = and(not(ew0_3), not(ew1_3), not(ew2_3), ew3_4, ew3_5, ew3_6)
output em4 = and(not(ew0_4), not(ew1_4), not(ew2_4), not(ew3_4), ew4_5, ew4_6)
output em5 = and(not(ew0_5), not(ew1_5), not(ew2_5), not(ew3_5), not(ew4_5), ew5_6)
output em6 = and(not(ew0_6), not(ew1_6), not(ew2_6), not(ew3_6), not(ew4_6), not(ew5_6))
