wir 0.2
# Senses of a tactical enemy (generated by `wir tactics`). A grid program, read at the
# enemy's cell. dp is the distance to the player, dc the distance to cover (8-move
# fields, a straight step costs 2), exp 1 where the player can see the cell, ally 1
# where another enemy stands. Headings 0..7 are E NE N NW W SW S SE.

input dp: grid in [0, 96] pad 96
input dc: grid in [0, 96] pad 96
input exp: grid in [0, 1] pad 0
input wall: grid in [0, 1] pad 1
input ally: grid in [0, 1] pad 0

# Allies cost extra to pass in dp, so an enemy's own cell reads high there: neighbours
# are graded against the best neighbour instead. gp, gc: 1 within 1 of the best step,
# 0 within 3 (partial progress), -1 farther (sideways or back).
let mp = min(min(min(dp[0, 1], dp[-1, 1]), min(dp[-1, 0], dp[-1, -1])), min(min(dp[0, -1], dp[1, -1]), min(dp[1, 0], dp[1, 1])))
let mc = min(min(min(dc[0, 1], dc[-1, 1]), min(dc[-1, 0], dc[-1, -1])), min(min(dc[0, -1], dc[1, -1]), min(dc[1, 0], dc[1, 1])))
output gp0 = le(dp[0, 1] - mp, 1) - ge(dp[0, 1] - mp, 4)
output gp1 = le(dp[-1, 1] - mp, 1) - ge(dp[-1, 1] - mp, 4)
output gp2 = le(dp[-1, 0] - mp, 1) - ge(dp[-1, 0] - mp, 4)
output gp3 = le(dp[-1, -1] - mp, 1) - ge(dp[-1, -1] - mp, 4)
output gp4 = le(dp[0, -1] - mp, 1) - ge(dp[0, -1] - mp, 4)
output gp5 = le(dp[1, -1] - mp, 1) - ge(dp[1, -1] - mp, 4)
output gp6 = le(dp[1, 0] - mp, 1) - ge(dp[1, 0] - mp, 4)
output gp7 = le(dp[1, 1] - mp, 1) - ge(dp[1, 1] - mp, 4)
output gc0 = le(dc[0, 1] - mc, 1) - ge(dc[0, 1] - mc, 4)
output gc1 = le(dc[-1, 1] - mc, 1) - ge(dc[-1, 1] - mc, 4)
output gc2 = le(dc[-1, 0] - mc, 1) - ge(dc[-1, 0] - mc, 4)
output gc3 = le(dc[-1, -1] - mc, 1) - ge(dc[-1, -1] - mc, 4)
output gc4 = le(dc[0, -1] - mc, 1) - ge(dc[0, -1] - mc, 4)
output gc5 = le(dc[1, -1] - mc, 1) - ge(dc[1, -1] - mc, 4)
output gc6 = le(dc[1, 0] - mc, 1) - ge(dc[1, 0] - mc, 4)
output gc7 = le(dc[1, 1] - mc, 1) - ge(dc[1, 1] - mc, 4)

# e: the player can see the next cell
output e0 = exp[0, 1]
output e1 = exp[-1, 1]
output e2 = exp[-1, 0]
output e3 = exp[-1, -1]
output e4 = exp[0, -1]
output e5 = exp[1, -1]
output e6 = exp[1, 0]
output e7 = exp[1, 1]

# n: allies in each heading's sector of the 5 x 5 window (3 cells each), capped at 4
output n0 = 4 - relu(4 - (ally[-1, 2] + ally[0, 1] + ally[0, 2]))
output n1 = 4 - relu(4 - (ally[-2, 1] + ally[-2, 2] + ally[-1, 1]))
output n2 = 4 - relu(4 - (ally[-2, -1] + ally[-2, 0] + ally[-1, 0]))
output n3 = 4 - relu(4 - (ally[-2, -2] + ally[-1, -2] + ally[-1, -1]))
output n4 = 4 - relu(4 - (ally[0, -2] + ally[0, -1] + ally[1, -2]))
output n5 = 4 - relu(4 - (ally[1, -1] + ally[2, -2] + ally[2, -1]))
output n6 = 4 - relu(4 - (ally[1, 0] + ally[2, 0] + ally[2, 1]))
output n7 = 4 - relu(4 - (ally[1, 1] + ally[1, 2] + ally[2, 2]))

# b: blocked by a wall, an ally or the player (dp 0); a diagonal also by a wall beside it
output b0 = or(wall[0, 1], ally[0, 1], le(dp[0, 1], 0))
output b1 = or(wall[-1, 1], ally[-1, 1], le(dp[-1, 1], 0), wall[-1, 0], wall[0, 1])
output b2 = or(wall[-1, 0], ally[-1, 0], le(dp[-1, 0], 0))
output b3 = or(wall[-1, -1], ally[-1, -1], le(dp[-1, -1], 0), wall[-1, 0], wall[0, -1])
output b4 = or(wall[0, -1], ally[0, -1], le(dp[0, -1], 0))
output b5 = or(wall[1, -1], ally[1, -1], le(dp[1, -1], 0), wall[1, 0], wall[0, -1])
output b6 = or(wall[1, 0], ally[1, 0], le(dp[1, 0], 0))
output b7 = or(wall[1, 1], ally[1, 1], le(dp[1, 1], 0), wall[1, 0], wall[0, 1])

# the enemy's own cell: distance after the best step, seen, how its cover compares
output dps = mp
output es = exp
output gcs = le(dc - mc, 1) - ge(dc - mc, 4)
